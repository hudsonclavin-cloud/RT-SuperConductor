 &control
    calculation = 'scf'
    prefix      = 'kinh3'
    pseudo_dir  = '../pp/'
    outdir      = './tmp'
    tprnfor     = .true.
    tstress     = .true.
 /
 &system
    ibrav       = 0
    nat         = 5
    ntyp        = 3
    ecutwfc     = 90
    occupations = 'smearing'
    smearing    = 'mv'
    degauss     = 0.02
    la2F        = .true.
 /
 &electrons
    mixing_beta = 0.4
    conv_thr    = 1.0d-12
 /
