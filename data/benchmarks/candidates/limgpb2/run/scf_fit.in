 &control
    calculation = 'scf'
    prefix      = 'limgpb2'
    pseudo_dir  = '../pp/'
    outdir      = './tmp'
    tprnfor     = .true.
    tstress     = .true.
 /
 &system
    ibrav       = 0
    nat         = 4
    ntyp        = 3
    ecutwfc     = 90
    occupations = 'smearing'
    smearing    = 'mv'
    degauss     = 0.02
    la2F        = .true.
 /
 &electrons
    mixing_beta = 0.4
    conv_thr    = 1.0d-12
 /
ATOMIC_SPECIES
 Li 6.94100 Li_ONCV_PBE_sr.upf
 Mg 24.30500 Mg_ONCV_PBE_sr.upf
 Pb 207.20000 Pb_ONCV_PBE_sr.upf
CELL_PARAMETERS angstrom
 0.000000000 3.685562455 3.685562455
 3.685562455 0.000000000 3.685562455
 3.685562455 3.685562455 0.000000000
ATOMIC_POSITIONS crystal
 Li 0.500000000 0.500000000 0.500000000
 Mg 0.000000000 0.000000000 0.000000000
 Pb 0.250000000 0.250000000 0.250000000
 Pb 0.750000000 0.750000000 0.750000000
K_POINTS automatic
 16 16 16 0 0 0
