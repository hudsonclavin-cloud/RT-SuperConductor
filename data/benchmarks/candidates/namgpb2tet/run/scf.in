 0.000000000 3.766285796 0.000000000
 0.000000000 0.000000000 7.850627642
ATOMIC_POSITIONS crystal
 Na 0.500000000 0.500000000 0.500000000
 Mg 0.500000000 0.500000000 0.000000000
